# FiveM Player Intelligence & Monitoring Dashboard (Badside Monitor)
PORT=3001
NEXT_PUBLIC_APP_NAME="FiveM Player Intelligence & Monitoring Dashboard"
NEXT_PUBLIC_SYSTEM_CODENAME="BADSIDE WATCHTOWER // SOC INTEL"

# Database Configuration (PostgreSQL / SQLite)
# For Supabase/PostgreSQL: DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"
DATABASE_URL="file:./dev.db"

# FiveM Server Live Configuration
FIVEM_SERVER_IP="127.0.0.1"
FIVEM_SERVER_PORT="30120"
FIVEM_API_SECRET="badside_soc_secret_token_99x"

# Discord Bot / OAuth Integration
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""

# Discord webhook for alerts (watchlist online, character switch, group convergence)
DISCORD_ALERT_WEBHOOK_URL=""
# Only alerts at or above this severity are forwarded: INFO | WARNING | CRITICAL
DISCORD_ALERT_MIN_SEVERITY="WARNING"

# Audit & Security Settings
ENABLE_IDENTIFIER_MASKING=true
REQUIRE_AUDIT_ON_REVEAL=true
DEFAULT_HEARTBEAT_TIMEOUT_SEC=30
